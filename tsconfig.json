{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "noImplicitThis": true,
    "useDefineForClassFields": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["js/**/*.js", "js/**/*.d.ts"]
}